# Demo works without credentials. Never prefix secrets with NEXT_PUBLIC_.
# Supabase Postgres connection string (see db/README.md). Empty = in-memory PGlite, resets on restart.
DATABASE_URL=
# Supabase root CA: PEM contents (Vercel) or a file path (local). See db/README.md.
DATABASE_CA_CERT=
# Event code people type or scan to join (default SUPERSET).
EVENT_CODE=
GITHUB_TOKEN=
# Optional opportunity drafting via an OpenAI-compatible chat completions endpoint.
# All three must be set (MODEL_API_URL is the full endpoint URL); otherwise a template is used.
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=

# Provider keys: enable whichever providers you use.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AGENT_PROVIDER=openrouter
AGENT_MODEL=nvidia/nemotron-3.5-lightning:free
AGENT_ACCESS_CODE=
