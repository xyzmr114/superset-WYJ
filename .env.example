# Demo works without credentials. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=
GITHUB_TOKEN=
# Optional opportunity drafting via an OpenAI-compatible chat completions endpoint.
# All three must be set (MODEL_API_URL is the full endpoint URL); otherwise a template is used.
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=

# Provider keys: enable whichever providers you use.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AGENT_PROVIDER=deepseek
AGENT_MODEL=deepseek-flash
AGENT_ACCESS_CODE=

# OpenCode is the application harness; sdk is available for development diagnostics.
AGENT_HARNESS=opencode
