# Demo works without credentials. Never prefix secrets with NEXT_PUBLIC_.
# Supabase Postgres connection string (see db/README.md). Empty = in-memory PGlite, resets on restart.
DATABASE_URL=
# Supabase root CA: PEM contents (Vercel) or a file path (local). See db/README.md.
DATABASE_CA_CERT=
# Event code people type or scan to join (default SUPERSET).
EVENT_CODE=
GITHUB_TOKEN=
# Optional opportunity drafting via an OpenAI-compatible chat completions endpoint.
# All three must be set (MODEL_API_URL is the full endpoint URL); otherwise a template is used.
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=

# Provider keys: enable whichever providers you use.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AGENT_PROVIDER=deepseek
AGENT_MODEL=deepseek-flash
AGENT_ACCESS_CODE=

# OpenCode is the application harness; sdk is available for development diagnostics.
AGENT_HARNESS=opencode

# Premium refinement receives only a separately approved published brief.
PREMIUM_DEEPSEEK_MODEL=deepseek-flash

# Legacy free-form cloud harness: off by default; enabling also requires a Premium session.
ENABLE_LEGACY_AGENT=false
# Public Blob prefix, e.g. https://store.public.blob.vercel-storage.com/wyj-models-v1
MODEL_ASSET_BASE_URL=
# Local upload script only. Never expose via NEXT_PUBLIC_*.
BLOB_READ_WRITE_TOKEN=
