{
  "name": "would-you-jump",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "test": "tsx --test \"lib/**/*.test.ts\" \"components/**/*.test.ts\"",
    "seed": "tsx scripts/seed-demo.ts",
    "classifier:setup": "sh scripts/local-classifier/setup.sh",
    "classifier": "test -x .wyj-local/venv/bin/python && ls .wyj-local/hf/models--convaiinnovations--laya/snapshots/*/model.safetensors >/dev/null 2>&1 || { echo 'run pnpm classifier:setup first'; exit 1; }; HF_HUB_CACHE=.wyj-local/hf .wyj-local/venv/bin/python scripts/local-classifier/server.py",
    "tui": "bun --env-file=.env.local --tsconfig-override=tui/tsconfig.json tui/index.tsx",
    "typecheck:tui": "tsc --project tui/tsconfig.json --noEmit",
    "browser:prepare": "sh scripts/browser-laya/setup.sh",
    "bonsai:prepare": "node scripts/browser-bonsai/prepare.mjs",
    "models:manifest": "node scripts/model-assets/manifest.mjs",
    "models:upload": "node --env-file-if-exists=.env.local scripts/model-assets/upload.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/openai-compatible": "^3.0.75",
    "@electric-sql/pglite": "~0.3.16",
    "@huggingface/transformers": "4.1.0",
    "@opencode-ai/sdk": "^1.19.3",
    "@opentui/core": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "@tanstack/react-query": "5.104.5",
    "@vercel/blob": "^2.8.2",
    "ai": "^7.0.148",
    "next": "16.4.2",
    "onnxruntime-web": "1.24.3",
    "opencode-ai": "^1.19.3",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun": "^1.4.3",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
